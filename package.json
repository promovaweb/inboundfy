{
  "name": "inboundfy",
  "version": "0.8.3",
  "description": "Inbound marketing framework with AI skills: CLI, TUI and MCP stdio server to install the framework and manage the archive, channels and editorial calendar.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "inboundfy": "src/main.ts"
  },
  "termfy": {
    "bin": "inboundfy",
    "title": "Inboundfy",
    "author": "Promovaweb",
    "site": "https://promovaweb.com/docs/inboundfy",
    "repository": "https://github.com/promovaweb/inboundfy",
    "framework": "https://github.com/promovaweb/termfy",
    "starterKit": "0.13.4"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "tui": "bun run src/main.ts",
    "mcp": "bun run src/main.ts mcp",
    "payload": "bun run scripts/build-payload.ts",
    "payload:check": "bun run scripts/build-payload.ts --check",
    "build": "bun run scripts/build-payload.ts && bun run scripts/build.ts",
    "build:all": "bun run scripts/build-payload.ts && bun run scripts/build.ts --all",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "opencli": "bun run src/main.ts --opencli > docs/opencli.json",
    "opencli:check": "bun run scripts/check-opencli.ts",
    "skills:install": "npx -y skills add https://github.com/promovaweb/termfy -y -a universal -a claude-code -a codex -a opencode -a cursor -a gemini-cli",
    "skills:update": "npx -y skills update -y -p",
    "skills:check": "bun run scripts/check-skills.ts",
    "framework:check": "bun scripts/gerenciar-skills.mjs --check && bun scripts/validar-framework.mjs",
    "framework:enrich": "bun scripts/gerenciar-skills.mjs --write",
    "docs:check": "bun run scripts/check-docs.ts",
    "ebook": "bun .ebook/build-ebook.mjs",
    "ebook:verify": "bun .ebook/build-ebook.mjs --check",
    "npm:readme": "bun run scripts/npm-readme.ts",
    "validate": "bun run typecheck && bun test && bun run skills:check && bun run framework:check && bun run opencli:check && bun run docs:check && bun run build"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/inboundfy.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "ai-agents",
    "inbound-marketing",
    "content",
    "copywriting",
    "skills",
    "cli",
    "mcp",
    "tui"
  ]
}
