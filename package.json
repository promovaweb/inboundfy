{
  "name": "@promovaweb/inboundfy",
  "version": "0.2.0",
  "description": "CLI e framework de skills para instalar, validar e manter o Inboundfy em projetos.",
  "type": "module",
  "bin": {
    "inboundfy": "bin/inboundfy.cjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "context",
    "templates",
    "docs",
    "ebook",
    "brand",
    "examples",
    "BRAINSTORM.md",
    "CONTEXTO.md",
    "ESCRITA.md",
    "ESTRATEGIA.md",
    "ESTRUTURAS-PERSUASIVAS.md",
    "INSTALACAO.md",
    "LIMPEZA-MATERIAL-BRUTO.md",
    "METODOLOGIA.md",
    "README.md",
    "RELEASING.md",
    "SKILL-AUTORIA.md",
    "SKILLS.md",
    "TRADUCAO.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "skills:check": "node scripts/gerenciar-skills.mjs --check",
    "skills:enriquecer": "node scripts/gerenciar-skills.mjs --write",
    "test": "vitest run && node scripts/validar-framework.mjs",
    "ebook": "node .ebook/build-ebook.mjs",
    "ebook:verify": "node .ebook/build-ebook.mjs --check",
    "release:sync": "node scripts/sync-release-version.mjs && npm run ebook",
    "release:check": "node scripts/validate-release.mjs",
    "npm:validate-package": "node scripts/validate-npm-package.mjs",
    "publish:npm": "node scripts/publish-npm-package.mjs",
    "prepack": "npm run build && npm run release:check",
    "validar": "npm run skills:check && npm run typecheck && npm test && npm run build && npm run ebook:verify && npm run release:check"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [
    "ai-agents",
    "cli",
    "content",
    "copywriting",
    "marketing",
    "skills"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/inboundfy.git"
  },
  "bugs": {
    "url": "https://github.com/promovaweb/inboundfy/issues"
  },
  "homepage": "https://github.com/promovaweb/inboundfy#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
